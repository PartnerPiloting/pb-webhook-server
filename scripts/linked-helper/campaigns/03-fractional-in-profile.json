          "miniProfileFields": {
            "fullName": true,
            "lastName": true,
            "headline": true,
            "avatar": true,
            "originalValues": true,
            "customValues": true
          }
        }
      },
      "coolDownMinutes": 0,
      "maxActionResultsPerIteration": -1,
      "workingHours": "always"
    }
