{
  "//": "Client base schema - the version-controlled replacement for duplicating My Leads - Client Template. Generated 2026-08-25 from the live template (app6W6k9GiDlJktvt) filtered to the fields the deployed code actually reads/writes (see Stripe cutover brief, section 2). Posts CONFIG tables dropped (offering retired 25 Aug); posts fields on Leads kept (portal still reads them). computed:true fields need special handling - see scripts/create-client-base.js.",
  "tables": [
    {
      "name": "Leads",
      "fields": [
        {
          "name": "Profile Key",
          "type": "formula",
          "options": {
            "formula": "LOWER(\r\n  SUBSTITUTE(\r\n    SUBSTITUTE(\r\n      IF(\r\n        RIGHT({LinkedIn Profile URL}, 1) = \"/\",\r\n        LEFT({LinkedIn Profile URL}, LEN({LinkedIn Profile URL}) - 1),\r\n        {LinkedIn Profile URL}\r\n      ),\r\n      \"https://\",\r\n      \"\"\r\n    ),\r\n    \"http://\",\r\n    \"\"\r\n  )\r\n)"
          },
          "computed": true
        },
        {
          "name": "First Name",
          "type": "singleLineText"
        },
        {
          "name": "LinkedIn Profile URL",
          "type": "url"
        },
        {
          "name": "Last Name",
          "type": "singleLineText"
        },
        {
          "name": "Notes",
          "type": "multilineText"
        },
        {
          "name": "Follow-Up Date",
          "type": "date",
          "options": {
            "dateFormat": {
              "name": "local",
              "format": "l"
            }
          }
        },
        {
          "name": "Email",
          "type": "email"
        },
        {
          "name": "Phone",
          "type": "phoneNumber"
        },
        {
          "name": "Send At",
          "type": "dateTime",
          "options": {
            "dateFormat": {
              "name": "local",
              "format": "l"
            },
            "timeFormat": {
              "name": "12hour",
              "format": "h:mma"
            },
            "timeZone": "client"
          }
        },
        {
